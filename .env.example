# Copy to .env. Values stored in Settings override these.
# If a Settings field is empty, the matching variable below is used.
# Keep this file local. The app stores refresh tokens and should stay on localhost.

# Database
# Vercel cannot open a SQLite file. Use the Neon pooled URL at runtime
# and the direct (non-pooler) URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&schema=autotube"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&schema=autotube"

# Public origin used for the Google OAuth redirect.
APP_URL="http://localhost:3000"

# Google Drive & YouTube OAuth
# Redirect URI to register: http://localhost:3000/api/auth/google/callback
# Enable the Drive API and YouTube Data API v3.
# While the consent screen is in testing, add your Google account as a test user.
# Share Drive folder with the OAuth user, or with the service-account email.
# DRIVE_FOLDER_ID can be the folder id or a full view-only / edit link:
# https://drive.google.com/drive/folders/1sS5RLXEKdz4Cb3K9vPp_sxKO75Ds36CL
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REFRESH_TOKEN="your-oauth2-refresh-token"
DRIVE_FOLDER_ID="1sS5RLXEKdz4Cb3K9vPp_sxKO75Ds36CL"

# Gemini AI
# New API keys should use gemini-3.8-flash. The model can be changed in Settings.
GEMINI_API_KEY="your-gemini-api-key"

# Schedule Config
DAILY_UPLOAD_COUNT=2
UPLOAD_TIMES="10:00,18:00"
TIMEZONE="Asia/Kolkata"

# ffmpeg must be installed (ffmpeg and ffprobe on PATH).
# YouTube's default quota allows about six videos.insert calls per day.
# Two uploads per day fits that quota.
# Start the uploader with: npm run worker
